---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SfptTbd from '../../components/SfptTbd.astro';
import '../../styles/sfpt.css';

const title = 'Self-Forcing Post-Training of Diffusion and Flow Models for Speech Enhancement';
---

<BaseLayout
	title={`${title} — Qing Yao`}
	description="Paper demo for Self-Forcing Post-Training (SFPT), a post-training framework that closes the training-inference mismatch of diffusion and flow speech-enhancement models."
	bodyClass="sfpt-body"
>
	<main class="sfpt-page">
		<!--
			AGENT RESOURCE NOTE (intentionally hidden from rendered page visitors):
			This is the public SFPT paper demo page. The committed version is intentionally
			minimal: title, authors, and a TBD placeholder — the abstract and interactive
			demo content (benchmark bar charts, quality-vs-NFE curves, audio samples) are
			under development and will be added here, mirroring the /RSB/ page layout
			(src/pages/RSB/index.astro). The paper's first-page footnote points readers
			of the SFPT manuscript to this exact URL (https://yorch233.github.io/SFPT).
		-->
		<article class="sfpt-article">
			<img class="sfpt-watermark" src="/logo/icon.png" alt="" aria-hidden="true" />

			<header class="sfpt-hero sfpt-fade sfpt-delay-1">
				<p class="sfpt-kicker">Paper demo</p>
				<h1 class="sfpt-title">
					<span class="sfpt-highlight">Self-Forcing Post-Training</span>
					of Diffusion and Flow Models for
					<span class="sfpt-highlight">Speech Enhancement</span>
				</h1>

				<p class="sfpt-authors">
					<span class="sfpt-author">
						<span class="sfpt-author-name">Qing Yao</span>
						<a class="sfpt-email" href="mailto:qyao@stmail.ujs.edu.cn">qyao@stmail.ujs.edu.cn</a>
					</span>
					<span class="sfpt-author">
						<span class="sfpt-author-name">Lijian Gao</span>
						<a class="sfpt-email" href="mailto:ljgao@ujs.edu.cn">ljgao@ujs.edu.cn</a>
					</span>
					<span class="sfpt-author">
						<span class="sfpt-author-name">Qirong Mao <sup class="sfpt-tag">†</sup></span>
						<a class="sfpt-email" href="mailto:mao_qr@ujs.edu.cn">mao_qr@ujs.edu.cn</a>
					</span>
				</p>

				<ul class="sfpt-affiliations">
					<li>School of Computer Science and Communication Engineering, Jiangsu University</li>
				</ul>
				<p class="sfpt-affiliation-note"><sup class="sfpt-tag">†</sup> Corresponding Author</p>
			</header>

			<div class="sfpt-fade sfpt-delay-2">
				<SfptTbd />
			</div>
		</article>

		<footer class="sfpt-footer sfpt-fade sfpt-delay-3">
			<span class="sfpt-footer-copy">© 2026 Qing Yao. All rights reserved.</span>
		</footer>
	</main>
</BaseLayout>
